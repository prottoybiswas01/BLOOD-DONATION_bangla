ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
DAILY_CONTACT_LIMIT=5

# Single Authoritative Super Admin Credentials
SUPER_ADMIN_PHONE=01700000001
SUPER_ADMIN_PASSWORD=Admin@2026!Secure
SUPER_ADMIN_NAME=সুপার অ্যাডমিন (Super Admin)
