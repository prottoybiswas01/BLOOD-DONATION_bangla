# Bangladesh Blood Donation Platform Environment Configuration

# Server Port
PORT=5000

# Environment Mode
NODE_ENV=development

# MongoDB Connection String (Leave blank for automatic zero-config In-Memory Datastore)
MONGO_URI=mongodb://127.0.0.1:27017/bangladesh_blood_db

# JWT Authentication Secret
JWT_SECRET=super_secret_jwt_key_change_in_production_2026
JWT_EXPIRES_IN=7d

# SMS Provider Adapter ('mock' | 'bulksmsbd' | 'greenweb' | 'twilio')
SMS_PROVIDER=mock
SMS_API_KEY=

# Client Application URL
CLIENT_URL=http://localhost:3000

# Privacy & Rate Limiting: Max contact number reveals per day per authenticated viewer
DAILY_CONTACT_LIMIT=5
