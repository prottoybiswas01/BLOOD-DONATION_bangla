# Server Configuration
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority
JWT_SECRET=your_secure_random_jwt_secret_key_here
JWT_EXPIRES_IN=7d
SMS_PROVIDER=mock
SMS_API_KEY=
